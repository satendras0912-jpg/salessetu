# Public Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase administrator key
# SUPABASE_SERVICE_ROLE_KEY is also supported as a legacy fallback.
SUPABASE_SECRET_KEY=

# Public application URL
NEXT_PUBLIC_APP_URL=https://salessetu.in

# AI calling internal dispatch protection
AI_CALL_DISPATCH_SECRET=

# Public base URL used for provider webhooks
AI_CALL_WEBHOOK_BASE_URL=https://salessetu.in

# Bland AI server-only credentials
AI_CALL_BLAND_API_KEY=
AI_CALL_BLAND_WEBHOOK_SECRET=